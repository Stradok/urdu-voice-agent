# Local development mode - set this to true when the backend is running against local Docker
# Postgres with LOCAL_AUTH_EMAIL set (see the root .env.example). The login screen then accepts
# any input without calling Supabase, because with Supabase gone there is no token issuer to
# call. Local development only.
VITE_LOCAL_AUTH=

# The same SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY values from the backend's .env (the
# publishable key is safe for client-side use by design). Leave blank in local mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
