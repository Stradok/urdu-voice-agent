# Copy this file to .env and fill in the values below, then run: python main.py --text
# (main.py loads .env automatically, keys are never committed if you keep .env out of version control)

# --- GROQ_API_KEY (LLM, free tier) ---
# 1. Go to https://console.groq.com
# 2. Sign up / log in (Google or GitHub login works)
# 3. Left sidebar -> "API Keys" -> "Create API Key"
# 4. Name it anything (e.g. "urdu-voice-agent"), copy the key (starts with gsk_...)
# 5. Paste it below. Free tier has generous rate limits, no credit card required.
GROQ_API_KEY=

# --- AZURE_SPEECH_KEY / AZURE_SPEECH_REGION (TTS, free tier) ---
# 1. Go to https://portal.azure.com and sign in (create a free Azure account if you don't have one,
#    no cost, may ask for a card for identity verification but the Speech free tier itself is $0)
# 2. Click "Create a resource" -> search "Speech" -> select "Speech" by Microsoft -> Create
# 3. Pricing tier: choose "Free F0" (500,000 characters/month free, resets monthly)
# 4. Pick a region close to you - remember it, you need it below.
#    IMPORTANT: use the short region CODE, not the display name, e.g. "eastus" not "East US",
#    "westeurope" not "West Europe" - the SDK rejects the display-name form.
# 5. After deployment: go to the resource -> "Keys and Endpoint" (left sidebar)
# 6. Copy "KEY 1" and the region code shown there (e.g. "eastus")
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
